WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_BOB_MODEL=ibm/granite-3-8b-instruct

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Git Configuration
GIT_USER_NAME="IBM Bob Automated Agent"
